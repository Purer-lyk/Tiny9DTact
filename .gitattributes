# Treat all text files as text, normalize line endings to LF in the repo
* text=auto eol=lf

# Force CRLF on Windows-only scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files git should not touch
*.npy binary
*.pt  binary
*.obj binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary

# Python diff helpers
*.py diff=python